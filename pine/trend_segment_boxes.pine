//@version=6
indicator("Trend Segment Boxes", "TrendBoxes", overlay = true, max_boxes_count = 20, max_lines_count = 20, max_labels_count = 20, max_bars_back = 5000)

// Pine Script cannot read drawings made with TradingView's own tools (Polyline, Path, etc.).
// Instead, the four swing points are "interactive inputs": with `confirm = true`, TradingView
// asks you to click each point on the chart when the indicator is added. Afterwards, select the
// indicator and drag its handles to move the points, or edit them in the settings dialog.

// ───── Swing points ─────
int   t1 = input.time(timestamp("01 Jan 2024 00:00"), "Point 1", confirm = true, inline = "p1")
float p1 = input.price(0.0, "", confirm = true, inline = "p1")
int   t2 = input.time(timestamp("01 Feb 2024 00:00"), "Point 2", confirm = true, inline = "p2")
float p2 = input.price(0.0, "", confirm = true, inline = "p2")
int   t3 = input.time(timestamp("01 Mar 2024 00:00"), "Point 3", confirm = true, inline = "p3")
float p3 = input.price(0.0, "", confirm = true, inline = "p3")
int   t4 = input.time(timestamp("01 Apr 2024 00:00"), "Point 4", confirm = true, inline = "p4")
float p4 = input.price(0.0, "", confirm = true, inline = "p4")

// ───── Style ─────
string GRP = "Style"
bool  snapToWicks = input.bool(true, "Snap points to bar high/low", group = GRP,
     tooltip = "Moves each point to the exact high (swing high) or low (swing low) of the bar you clicked.")
color upFill   = input.color(color.new(color.green, 70), "Up      fill", inline = "up", group = GRP)
color upBorder = input.color(color.new(color.black, 30), "border", inline = "up", group = GRP)
color upLine   = input.color(color.green, "line", inline = "up", group = GRP)
color dnFill   = input.color(color.new(color.red, 70), "Down  fill", inline = "dn", group = GRP)
color dnBorder = input.color(color.new(color.black, 30), "border", inline = "dn", group = GRP)
color dnLine   = input.color(color.red, "line", inline = "dn", group = GRP)
bool  showLines  = input.bool(true, "Show diagonal lines", group = GRP)
bool  showLabels = input.bool(true, "Show change labels", group = GRP)

string GRP_CTRL = "Controlling swing"
bool  showCtrl  = input.bool(true, "Show controlling swing (CSH/CSL)", group = GRP_CTRL,
     tooltip = "Uptrend (latest structure break is a higher high): the swing low that made that high. Downtrend (latest break is a lower low): the swing high that made that low. A close beyond it marks it as broken.")
color ctrlColor = input.color(color.blue, "Controlling swing colour", group = GRP_CTRL)
bool  showOpp   = input.bool(true, "Show prior opposite swing (PSH/PSL)", group = GRP_CTRL,
     tooltip = "The swing just before the controlling swing, on the other side: the prior swing high opposite a controlling low, or the prior swing low opposite a controlling high. This is the level the break of structure went through.")
color oppColor  = input.color(color.blue, "Prior swing colour", group = GRP_CTRL)

// ───── Put the points in time order ─────
// Points are sorted by time so each leg's direction (and colour) always follows the chart from
// left to right, even if the points were clicked or dragged out of order.
int N    = 4
int LAST = N - 1

array<int>   rawTime  = array.from(t1, t2, t3, t4)
array<float> rawPrice = array.from(p1, p2, p3, p4)
array<int>   sortIdx  = rawTime.sort_indices(order.ascending)
array<int>   pTime    = array.new<int>()
array<float> pPrice   = array.new<float>()
for k in sortIdx
    pTime.push(rawTime.get(k))
    pPrice.push(rawPrice.get(k))

// ───── Locate the bar under each point ─────
var array<int>   pIdx  = array.new<int>(N, na)
var array<float> pHigh = array.new<float>(N, na)
var array<float> pLow  = array.new<float>(N, na)

for i = 0 to LAST
    if na(pIdx.get(i)) and time >= pTime.get(i)
        pIdx.set(i, bar_index)
        pHigh.set(i, high)
        pLow.set(i, low)

// Price of point `i`, optionally snapped to its bar's high/low depending on whether it is a
// swing high (above its neighbours) or a swing low (below its neighbours).
pointPrice(int i) =>
    float raw    = pPrice.get(i)
    float result = raw
    if snapToWicks and not na(pIdx.get(i))
        float prevP  = i > 0 ? pPrice.get(i - 1) : na
        float nextP  = i < LAST ? pPrice.get(i + 1) : na
        bool  isHigh = (na(prevP) or raw >= prevP) and (na(nextP) or raw >= nextP)
        bool  isLow  = (na(prevP) or raw <= prevP) and (na(nextP) or raw <= nextP)
        result := isHigh ? pHigh.get(i) : isLow ? pLow.get(i) : raw
    result

// ───── Draw ─────
var array<box>   boxes  = array.new<box>()
var array<line>  lines  = array.new<line>()
var array<label> labels = array.new<label>()
var line         ctrlLine  = na
var label        ctrlLabel = na
var line         oppLine   = na
var label        oppLabel  = na

if barstate.islast
    for b in boxes
        b.delete()
    for l in lines
        l.delete()
    for lb in labels
        lb.delete()
    boxes.clear()
    lines.clear()
    labels.clear()
    ctrlLine.delete()
    ctrlLabel.delete()
    oppLine.delete()
    oppLabel.delete()

    for i = 0 to LAST - 1
        int   ta  = pTime.get(i)
        int   tb  = pTime.get(i + 1)
        float pa  = pointPrice(i)
        float pb  = pointPrice(i + 1)
        bool  up  = pb >= pa
        float top = math.max(pa, pb)
        float bot = math.min(pa, pb)

        boxes.push(box.new(ta, top, tb, bot, up ? upBorder : dnBorder, 1, xloc = xloc.bar_time, bgcolor = up ? upFill : dnFill))

        if showLines
            lines.push(line.new(ta, pa, tb, pb, xloc.bar_time, color = up ? upLine : dnLine, width = 1))

        if showLabels
            float  chg     = pb - pa
            float  pct     = pa != 0 ? chg / pa * 100 : na
            int    bars    = pIdx.get(i + 1) - pIdx.get(i)
            string sign    = chg >= 0 ? "+" : ""
            string barsTxt = na(bars) ? "" : "\n" + str.tostring(bars) + " candles"
            string txt     = sign + str.tostring(chg, format.mintick) + " (" + sign + str.tostring(pct, "#.##") + "%)" + barsTxt
            // Centre the label horizontally on the leg, counted in candles so gaps such as weekends
            // don't pull it off centre: above the box for up legs, below it for down legs.
            bool   byBar   = not na(bars)
            int    midX    = byBar ? math.round((pIdx.get(i) + pIdx.get(i + 1)) / 2) : math.round((ta + tb) / 2)
            labels.push(label.new(midX, up ? top : bot, txt, byBar ? xloc.bar_index : xloc.bar_time,
                 style = up ? label.style_label_down : label.style_label_up,
                 color = color.new(color.white, 100), textcolor = up ? upLine : dnLine, size = size.small))

    // ───── Controlling swing ─────
    // Walk back from the newest point to the latest break of structure: a swing high above the
    // previous swing high (higher high = uptrend) or a swing low below the previous swing low
    // (lower low = downtrend). The swing just before that break is the controlling swing: the
    // low that launched the higher high, or the high that launched the lower low.
    if showCtrl or showOpp
        int  ctrl      = na
        int  conf      = na
        bool ctrlIsLow = false
        for i = LAST to 2
            float cur   = pointPrice(i)
            float prev  = pointPrice(i - 1)
            float prev2 = pointPrice(i - 2)
            if na(cur) or na(prev) or na(prev2)
                continue
            bool isHigh = cur > prev
            if isHigh and cur > prev2
                ctrl      := i - 1
                conf      := i
                ctrlIsLow := true
                break
            if not isHigh and cur < prev2
                ctrl      := i - 1
                conf      := i
                ctrlIsLow := false
                break

        if not na(ctrl) and not na(pIdx.get(ctrl)) and not na(pIdx.get(conf))
            float lvl     = pointPrice(ctrl)
            int   x1      = pIdx.get(ctrl)
            // First candle after the break of structure that closes beyond the controlling swing.
            // (Limited to the last 5000 candles, the furthest back Pine can look.)
            int   brokeAt = na
            int   scanFrom = math.max(pIdx.get(conf) + 1, bar_index - 4999)
            if scanFrom <= bar_index
                for j = scanFrom to bar_index
                    float c = close[bar_index - j]
                    if ctrlIsLow ? c < lvl : c > lvl
                        brokeAt := j
                        break
            bool   broken = not na(brokeAt)
            // Pine labels can't rotate text, so the letters are stacked one per line to read vertically.
            string name   = ctrlIsLow ? "C\nS\nL" : "C\nS\nH"
            int    x2     = broken ? brokeAt : bar_index
            if showCtrl
                ctrlLine  := line.new(x1, lvl, x2, lvl, xloc.bar_index,
                     broken ? extend.none : extend.right, ctrlColor, line.style_dashed, 2)
                // Vertical label at the swing point: below a low, above a high.
                ctrlLabel := label.new(x1, lvl, name + "\n" + str.tostring(lvl, format.mintick) + (broken ? "\nbroken" : ""), xloc.bar_index,
                     style = ctrlIsLow ? label.style_label_up : label.style_label_down,
                     color = color.new(color.white, 100), textcolor = ctrlColor, size = size.small)

            // Prior opposite swing: the swing just before the controlling one (a high before a
            // controlling low, or a low before a controlling high), i.e. the level that was broken.
            int opp = ctrl - 1
            if showOpp and not na(pIdx.get(opp))
                float  oLvl  = pointPrice(opp)
                int    o1    = pIdx.get(opp)
                string oName = ctrlIsLow ? "P\nS\nH" : "P\nS\nL"
                oppLine  := line.new(o1, oLvl, bar_index, oLvl, xloc.bar_index, extend.right, oppColor, line.style_dashed, 2)
                oppLabel := label.new(o1, oLvl, oName + "\n" + str.tostring(oLvl, format.mintick), xloc.bar_index,
                     style = ctrlIsLow ? label.style_label_down : label.style_label_up,
                     color = color.new(color.white, 100), textcolor = oppColor, size = size.small)
