//@version=6
indicator("Swing Segment Boxes", "SwingBoxes", overlay = true, max_boxes_count = 50, max_lines_count = 50, max_labels_count = 50)

// Pine Script cannot read drawings made with TradingView's own tools (Polyline, Path, etc.).
// Instead, points 1-4 are "interactive inputs": with `confirm = true`, TradingView asks you to
// click each one on the chart when the indicator is added. Afterwards, select the indicator and
// drag its handles to move them, or edit them in the settings dialog.
//
// Points 5-8 are optional. TradingView prompts for every `confirm = true` input when the indicator
// is added, so they can't be optional clicks; instead, raise "Number of points" and set their
// date/time in the settings. Leave a price at 0 to place it automatically on the bar's high or low.

// ───── Swing points ─────
string GRP_PTS = "Swing points"
int   t1 = input.time(timestamp("01 Jan 2024 00:00"), "Point 1", confirm = true, inline = "p1", group = GRP_PTS)
float p1 = input.price(0.0, "", confirm = true, inline = "p1", group = GRP_PTS)
int   t2 = input.time(timestamp("01 Feb 2024 00:00"), "Point 2", confirm = true, inline = "p2", group = GRP_PTS)
float p2 = input.price(0.0, "", confirm = true, inline = "p2", group = GRP_PTS)
int   t3 = input.time(timestamp("01 Mar 2024 00:00"), "Point 3", confirm = true, inline = "p3", group = GRP_PTS)
float p3 = input.price(0.0, "", confirm = true, inline = "p3", group = GRP_PTS)
int   t4 = input.time(timestamp("01 Apr 2024 00:00"), "Point 4", confirm = true, inline = "p4", group = GRP_PTS)
float p4 = input.price(0.0, "", confirm = true, inline = "p4", group = GRP_PTS)

string GRP_EXTRA = "Extra points (optional)"
int   N  = input.int(4, "Number of points", minval = 4, maxval = 8, group = GRP_EXTRA,
     tooltip = "Points 5-8 are only used when this is raised above 4. Set their date/time below; leave the price at 0 to snap to the bar's high or low automatically.")
int   t5 = input.time(timestamp("01 May 2024 00:00"), "Point 5", inline = "p5", group = GRP_EXTRA)
float p5 = input.price(0.0, "", inline = "p5", group = GRP_EXTRA)
int   t6 = input.time(timestamp("01 Jun 2024 00:00"), "Point 6", inline = "p6", group = GRP_EXTRA)
float p6 = input.price(0.0, "", inline = "p6", group = GRP_EXTRA)
int   t7 = input.time(timestamp("01 Jul 2024 00:00"), "Point 7", inline = "p7", group = GRP_EXTRA)
float p7 = input.price(0.0, "", inline = "p7", group = GRP_EXTRA)
int   t8 = input.time(timestamp("01 Aug 2024 00:00"), "Point 8", inline = "p8", group = GRP_EXTRA)
float p8 = input.price(0.0, "", inline = "p8", group = GRP_EXTRA)

// ───── Style ─────
string GRP = "Style"
bool  snapToWicks = input.bool(true, "Snap points to bar high/low", group = GRP,
     tooltip = "Moves each point to the exact high (swing high) or low (swing low) of the bar you clicked.")
color upFill   = input.color(color.new(color.green, 70), "Up      fill", inline = "up", group = GRP)
color upBorder = input.color(color.new(color.black, 30), "border", inline = "up", group = GRP)
color upLine   = input.color(color.green, "line", inline = "up", group = GRP)
color dnFill   = input.color(color.new(color.red, 70), "Down  fill", inline = "dn", group = GRP)
color dnBorder = input.color(color.new(color.black, 30), "border", inline = "dn", group = GRP)
color dnLine   = input.color(color.red, "line", inline = "dn", group = GRP)
bool  showLines  = input.bool(true, "Show diagonal lines", group = GRP)
bool  showLabels = input.bool(true, "Show change labels", group = GRP)

// ───── Put the active points in time order ─────
// Points are sorted by time so each leg's direction (and colour) always follows the chart from
// left to right, even if the points were clicked, dragged or entered out of order.
int LAST = N - 1

array<int>   allTime  = array.from(t1, t2, t3, t4, t5, t6, t7, t8)
array<float> allPrice = array.from(p1, p2, p3, p4, p5, p6, p7, p8)
array<int>   rawTime  = allTime.slice(0, N)
array<float> rawPrice = allPrice.slice(0, N)
array<int>   sortIdx  = rawTime.sort_indices(order.ascending)
array<int>   pTime    = array.new<int>()
array<float> pPrice   = array.new<float>()
for k in sortIdx
    pTime.push(rawTime.get(k))
    pPrice.push(rawPrice.get(k))

// ───── Locate the bar under each point ─────
var array<int>   pIdx  = array.new<int>(8, na)
var array<float> pHigh = array.new<float>(8, na)
var array<float> pLow  = array.new<float>(8, na)

for i = 0 to LAST
    if na(pIdx.get(i)) and time >= pTime.get(i)
        pIdx.set(i, bar_index)
        pHigh.set(i, high)
        pLow.set(i, low)

// ───── Draw ─────
var array<box>   boxes  = array.new<box>()
var array<line>  lines  = array.new<line>()
var array<label> labels = array.new<label>()

if barstate.islast
    for b in boxes
        b.delete()
    for l in lines
        l.delete()
    for lb in labels
        lb.delete()
    boxes.clear()
    lines.clear()
    labels.clear()

    // Resolve points left at price 0: put them on the bar's low after an up leg, or on its
    // high after a down leg, so the swings keep alternating.
    array<float> base = array.new<float>(N, na)
    for i = 0 to LAST
        float raw = pPrice.get(i)
        if raw > 0
            base.set(i, raw)
        else if not na(pIdx.get(i))
            bool afterUp = i >= 2 ? base.get(i - 1) > base.get(i - 2) : i == 1 ? pHigh.get(i) < base.get(0) : true
            base.set(i, afterUp ? pLow.get(i) : pHigh.get(i))

    // Optionally snap each point to its bar's high or low, depending on whether it is a swing
    // high (above its neighbours) or a swing low (below its neighbours).
    array<float> price = base.copy()
    if snapToWicks
        for i = 0 to LAST
            float p = base.get(i)
            if not na(p) and not na(pIdx.get(i))
                float prevP  = i > 0 ? base.get(i - 1) : na
                float nextP  = i < LAST ? base.get(i + 1) : na
                bool  isHigh = (na(prevP) or p >= prevP) and (na(nextP) or p >= nextP)
                bool  isLow  = (na(prevP) or p <= prevP) and (na(nextP) or p <= nextP)
                price.set(i, isHigh ? pHigh.get(i) : isLow ? pLow.get(i) : p)

    for i = 0 to LAST - 1
        int   ta = pTime.get(i)
        int   tb = pTime.get(i + 1)
        float pa = price.get(i)
        float pb = price.get(i + 1)
        if na(pa) or na(pb)
            continue
        bool  up  = pb >= pa
        float top = math.max(pa, pb)
        float bot = math.min(pa, pb)

        boxes.push(box.new(ta, top, tb, bot, up ? upBorder : dnBorder, 1, xloc = xloc.bar_time, bgcolor = up ? upFill : dnFill))

        if showLines
            lines.push(line.new(ta, pa, tb, pb, xloc.bar_time, color = up ? upLine : dnLine, width = 1))

        if showLabels
            float  chg     = pb - pa
            float  pct     = pa != 0 ? chg / pa * 100 : na
            int    bars    = pIdx.get(i + 1) - pIdx.get(i)
            string sign    = chg >= 0 ? "+" : ""
            string barsTxt = na(bars) ? "" : "\n" + str.tostring(bars) + " candles"
            string txt     = sign + str.tostring(chg, format.mintick) + " (" + sign + str.tostring(pct, "#.##") + "%)" + barsTxt
            labels.push(label.new(math.round((ta + tb) / 2), up ? top : bot, txt, xloc.bar_time,
                 style = up ? label.style_label_down : label.style_label_up,
                 color = color.new(color.white, 100), textcolor = up ? upLine : dnLine, size = size.small))
